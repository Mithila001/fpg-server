# Example environment variables for fpg-server.
# Copy this to ".env" and populate with real values.
#
# ── Database ──────────────────────────────────────────────────────────────────
# If you are using the provided docker-compose PostgreSQL service:
#   DB_URL=postgresql://fpg:fpg@db:5432/fpg_db   (inside compose network)
#   DB_URL=postgresql://fpg:fpg@localhost:5432/fpg_db  (from host machine)
# For local sqlite development:
#   DB_URL=sqlite:///./dev.db

DB_URL=postgresql://fpg:fpg@localhost:5432/fpg_db

# ── Job / SSE timeouts ────────────────────────────────────────────────────────
# Hard wall-clock limit for the whole generation job (seconds).
FPG_GENERATION_API_TIMEOUT=180
# How long a finished job stays in the in-memory registry before purge (seconds).
JOB_REGISTRY_CLEANUP_DELAY=60

# ── Optuna tunables ───────────────────────────────────────────────────────────
# Maximum number of Optuna trials per generation request.
OPTUNA_TRIAL_COUNT=20
# Per-trial running timeout (seconds). Should be < FPG_GENERATION_API_TIMEOUT.
OPTUNA_TRIAL_TIMEOUT=170

# ── Feature flags ─────────────────────────────────────────────────────────────
# Set to false in cloud / presentation mode to skip all matplotlib disk saves.
# Set to true locally when you need debug plots.
ENABLE_PLOT_SAVING=true

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of frontend origins allowed to call this API.
# Add your local machine's LAN IP if needed:
#   CORS_ORIGINS=http://localhost:5173,http://192.168.1.42:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
