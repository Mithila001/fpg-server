# Structured application log threshold.
LOG_LEVEL=INFO

# Root for generated visualizations, JSON artifacts, and logs.
OUTPUT_ROOT=output
APPLICATION_LOGGING_ENABLED=true
FLOW_LOGGING_ENABLED=true
JSON_ARTIFACTS_ENABLED=true
PNG_ARTIFACTS_ENABLED=true
ATOMIC_WRITES_ENABLED=true

# Comma-separated frontend origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
