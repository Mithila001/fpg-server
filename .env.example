# Example environment variables for fpg-server
# Copy this to ".env" and populate with real values.
#
# Database connection string format for SQLModel/SQLAlchemy.
# If you are using the provided docker-compose PostgreSQL service:
#   DB_URL=postgresql://fpg:fpg@localhost:5433/fpg_db
# For local sqlite development you could instead use:
#   DB_URL=sqlite:///./dev.db

DB_URL=
FPG_GENERATION_API_TIMEOUT=60
JOB_REGISTRY_CLEANUP_DELAY=60
