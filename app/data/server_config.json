{
  "schema_version": 2,
  "server": {
    "api_prefix": "/api/v1",
    "cors_origins": ["http://localhost:5173", "http://127.0.0.1:5173"],
    "output_root": "output",
    "log_level": "INFO",
    "max_concurrent_jobs": 1,
    "max_queued_jobs": 16,
    "job_retention_seconds": 3600,
    "request_timeout_seconds": 60.0,
    "cancellation_grace_seconds": 2.0,
    "sse_heartbeat_seconds": 15.0
  },
  "units": {
    "project_units_per_meter": 10,
    "front_axis": "-Y"
  },
  "buildable_space": {
    "active_profile": "mock_residential_v1",
    "setback_profiles": {
      "mock_residential_v1": {
        "status": "mock_non_regulatory",
        "description": "Seed policy values; replace with verified local regulations before production use.",
        "calculation_mode": "base_plus_road_adjustment",
        "base_setbacks": {"front": 10, "back": 30, "left": 10, "right": 10},
        "road_adjustments": {
          "main_road": {"front": 5, "back": 0, "left": 5, "right": 5},
          "private_road": {"front": 5, "back": 0, "left": 0, "right": 0}
        }
      }
    },
    "usable_land_constraints": {
      "minimum_width": 80,
      "minimum_length": 80,
      "search_resolution": 5,
      "maximum_sweep_lines": 1000
    },
    "validation_limits": {
      "minimum_vertex_count": 4,
      "maximum_vertex_count": 50,
      "maximum_absolute_coordinate": 100000
    }
  },
  "generation_runtime": {
    "candidate_score_threshold": 75.0,
    "usable_floor_plan_score": 80.0,
    "presentable_floor_plan_score": 90.0,
    "solver_runs_per_candidate": 2,
    "require_final_critical_pass": true
  },
  "preprocessing": {
    "room_count_rules": [
      {"room_type": "bedroom", "minimum": 1, "maximum": 4},
      {"room_type": "bathroom", "minimum": 1, "maximum": 4},
      {"room_type": "attached_bathroom", "minimum": 0, "maximum": 4},
      {"room_type": "living_room", "minimum": 1, "maximum": 1},
      {"room_type": "kitchen", "minimum": 1, "maximum": 1},
      {"room_type": "dining_room", "minimum": 1, "maximum": 1},
      {"room_type": "hallway", "minimum": 1, "maximum": 1, "client_selectable": false},
      {"room_type": "veranda", "minimum": 1, "maximum": 1},
      {"room_type": "garage", "minimum": 0, "maximum": 1}
    ],
    "supported_aspect_ratios": [
      {"label": "1:2", "canonical_value": 0.5},
      {"label": "3:4", "canonical_value": 0.75},
      {"label": "1:1", "canonical_value": 1.0},
      {"label": "4:3", "canonical_value": 1.3333333333333333},
      {"label": "2:1", "canonical_value": 2.0}
